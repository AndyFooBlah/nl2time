{
  "name": "nl2time",
  "version": "0.3.0",
  "description": "Bidirectional natural language \u21c4 date/time: parse expressions like 'last week' into concrete intervals, and describe instants as '9pm last night' \u2014 deterministic core, optional LLM assist.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./llm": "./dist/llm/index.js",
    "./corpus": "./dist/corpus/runner.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyFooBlah/nl2time.git"
  },
  "homepage": "https://github.com/AndyFooBlah/nl2time#readme",
  "bugs": {
    "url": "https://github.com/AndyFooBlah/nl2time/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import:recognizers": "node scripts/import-recognizers.mjs",
    "baselines": "npm run build && node scripts/update-baselines.mjs",
    "eval": "npm run build && node scripts/eval.mjs"
  },
  "keywords": [
    "date",
    "time",
    "natural-language",
    "parser",
    "humanize",
    "relative-time",
    "temporal",
    "llm",
    "timezone",
    "locale"
  ],
  "dependencies": {
    "temporal-polyfill": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}